rules_version = '2';

// Lumina — Cloud Storage security rules.
// Paste into: Firebase Console -> Storage -> Rules -> Publish.
service firebase.storage {
  match /b/{bucket}/o {
    // Media is user-generated and app-visible to any signed-in user.
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }
    // Users may only write under their own folder, max 50 MB per file.
    match /posts/{uid}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 50 * 1024 * 1024;
    }
    match /avatars/{uid}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024;
    }
    // Stories and Highlights upload to their own per-user folders too.
    match /stories/{uid}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 50 * 1024 * 1024;
    }
    // Landing-page screenshots: public (signed-out visitors see them),
    // uploaded only by the admin account, images up to 5 MB.
    match /landing/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'santexnika.atoyo@gmail.com'
                   && request.auth.token.email_verified == true
                   && (request.resource == null
                       || (request.resource.size < 5 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*')));
    }
    match /highlights/{uid}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
