rules_version = '2';

// Lumina — Firestore security rules.
// Paste into: Firebase Console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in. A blocked user (userBans/{uid}) keeps read access but every
    // write fails here — and every write rule goes through signedIn() or
    // isOwner(). Reads skip the ban lookup, so they cost no extra document read.
    function signedIn() {
      return request.auth != null
        && (request.method in ['get', 'list'] || isOwnerAccount() || notBanned());
    }

    // The owner. The email alone is not proof: an unverified email/password
    // account could claim any address. The owner signs in with Google, whose
    // tokens always carry email_verified == true. Never affected by bans/roles.
    function isOwnerAccount() {
      return request.auth != null
        && request.auth.token.email == 'santexnika.atoyo@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Admin: the owner, or a verified account the owner/an admin promoted via
    // staffRoles/{uid}.role == 'admin'.
    function isAdmin() {
      return signedIn() && (isOwnerAccount() || hasStaffRole(['admin']));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // True when an update touches ONLY the listed fields (counter bumps).
    function onlyKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---- admin panel helpers (roles, bans, moderation) ----
    function notBanned() {
      return !exists(/databases/$(database)/documents/userBans/$(request.auth.uid));
    }

    function hasStaffRole(roles) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/staffRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffRoles/$(request.auth.uid)).data.role in roles;
    }

    // Moderator or admin: works the reports queue, hides posts, blocks users.
    function isStaff() {
      return signedIn() && (isOwnerAccount() || hasStaffRole(['admin', 'moderator']));
    }

    // Fields only staff may set on a post (an author must not unhide).
    function moderationKeys() {
      return ['hidden', 'hiddenAt', 'hiddenBy', 'hiddenReason'];
    }

    // "YYYY-MM-DD" of the request in UTC — daily-active buckets.
    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }
    function todayUtc() {
      return string(request.time.year()) + '-' + pad2(request.time.month()) + '-' + pad2(request.time.day());
    }

    // ---------------- users ----------------
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      // Owner edits own profile; anyone signed-in may only bump social counters
      // (follow/unfollow transactions touch the other user's counts).
      allow update: if isOwner(uid)
                    || (signedIn() && onlyKeys(['followerCount', 'followingCount', 'postCount']));
      allow delete: if false;

      match /saves/{postId} {
        allow read, write: if isOwner(uid);
      }
      match /seenStories/{storyId} {
        allow read, write: if isOwner(uid);
      }
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(uid);
        // Other users generate notifications for you (like/comment/follow).
        allow create: if signedIn();
      }
      // Close Friends list. Readable by the owner (to manage it) and by the
      // listed friend (a viewer checks whether they're in an author's list to
      // gate Close-Friends stories); writable only by the owner.
      match /closeFriends/{friendId} {
        allow read: if isOwner(uid) || isOwner(friendId);
        allow write: if isOwner(uid);
      }
      // Block / restrict lists — private to the owner.
      match /blocked/{blockedId} {
        allow read, write: if isOwner(uid);
      }
      match /restricted/{restrictedId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------------- posts ----------------
    // Collab invite: { uid, status, user }. The author can only create it
    // as 'pending' for someone else, and can never change it afterwards
    // (so they can't accept on the invitee's behalf).
    function validNewCollab(data) {
      return !('collab' in data)
        || (data.collab is map
            && data.collab.keys().hasOnly(['uid', 'status', 'user'])
            && data.collab.uid is string
            && data.collab.uid != request.auth.uid
            && data.collab.status == 'pending'
            && data.collab.user is map
            && data.collab.user.id == data.collab.uid);
    }

    function collabUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['collab']);
    }

    // Only the invited uid, only pending → accepted/declined, nothing else.
    function collabAnswer() {
      return signedIn()
        && resource.data.get('collab', null) is map
        && resource.data.collab.uid == request.auth.uid
        && resource.data.collab.status == 'pending'
        && onlyKeys(['collab'])
        && request.resource.data.collab.keys().hasOnly(['uid', 'status', 'user'])
        && request.resource.data.collab.uid == resource.data.collab.uid
        && request.resource.data.collab.user == resource.data.collab.user
        && request.resource.data.collab.status in ['accepted', 'declined'];
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && validNewCollab(request.resource.data)
                    && !request.resource.data.keys().hasAny(moderationKeys());
      allow update: if signedIn()
                    && ((resource.data.authorId == request.auth.uid
                         && collabUntouched()
                         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(moderationKeys()))
                        || onlyKeys(['likeCount', 'commentCount'])
                        || collabAnswer()
                        || (isStaff() && onlyKeys(moderationKeys())));
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }
      match /saves/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // ---------------- reels ----------------
    match /reels/{reelId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn()
                    && (resource.data.authorId == request.auth.uid
                        || onlyKeys(['likeCount', 'commentCount', 'shareCount']));
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      // Hiding a reported video post also removes its reel copy (admin panel).
      allow delete: if isStaff();

      match /likes/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }
      match /saves/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }
    }

    // ---------------- stories ----------------
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /reactions/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }

      // "Seen by" list. A viewer records only themselves, never on their own
      // story (the author's view doesn't count); only the author reads it.
      match /views/{viewerUid} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid;
        allow create, update: if isOwner(viewerUid)
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorId != viewerUid
          && request.resource.data.keys().hasOnly(['uid', 'viewer', 'viewedAt'])
          && request.resource.data.uid == viewerUid
          && request.resource.data.viewer is map
          && request.resource.data.viewer.id == viewerUid
          && request.resource.data.viewedAt is string
          && request.resource.data.viewedAt.size() <= 40;
        allow delete: if false;
      }
    }

    // ---------------- highlights ----------------
    match /highlights/{highlightId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ---------------- follows ----------------
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
    }

    // ---------------- follow requests ----------------
    // Doc id: `${targetId}_${requesterId}`.
    match /followRequests/{requestId} {
      allow read: if signedIn()
                  && (resource.data.targetId == request.auth.uid
                      || resource.data.requesterId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid;
      // The target accepts/rejects; the requester may cancel their own.
      allow delete: if signedIn()
                    && (resource.data.targetId == request.auth.uid
                        || resource.data.requesterId == request.auth.uid);
    }

    // ---------------- notes (Direct inbox) ----------------
    // Doc id = author uid. Readable by the author and by anyone who follows
    // them (follow edge id is `${followerId}_${followeeId}`); writable only
    // by the author.
    match /notes/{uid} {
      allow read: if isOwner(uid)
                  || (signedIn()
                      && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)));
      allow write: if isOwner(uid);
    }

    // ---------------- messaging ----------------
    match /conversations/{conversationId} {
      // `resource == null` allows a get() on a not-yet-created conversation,
      // which getOrCreateConversation needs before writing it.
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participantIds);
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if signedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update, delete: if false;
      }
    }
  
    // ---------------- reports (moderation) ----------------
    // Anyone signed-in can file a report (always as 'open'); staff read them.
    // The filing itself never changes — staff may only move its status along
    // open -> reviewing -> resolved | dismissed (or reopen to reviewing).
    // A report without `status` (filed before 2026-10-11) counts as open.
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid
        && (!('status' in request.resource.data) || request.resource.data.status == 'open');
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'updatedBy'])
        && validReportTransition(resource.data.get('status', 'open'), request.resource.data.status)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // Audit trail: one entry per moderator step (status change, note,
      // hide post, block user). Staff-only, never edited once written.
      // Pre-2026-10-11 entries are { outcome, moderatorId, createdAt }.
      match /resolutions/{resolutionId} {
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(
               ['action', 'status', 'note', 'moderatorId', 'moderatorEmail', 'createdAt', 'outcome'])
          && request.resource.data.moderatorId == request.auth.uid
          && (!('note' in request.resource.data)
              || (request.resource.data.note is string && request.resource.data.note.size() <= 1000));
        allow update, delete: if false;
      }
    }

    function validReportTransition(from, to) {
      return (from in ['open', 'reviewing'] && to in ['open', 'reviewing', 'resolved', 'dismissed'] && from != to)
        || (from in ['resolved', 'dismissed'] && to == 'reviewing');
    }

    // ---------------- contact form (landing page) ----------------
    // Visitors are usually signed out, so create is open — but only in this
    // exact, size-capped shape, stamped with the server time. Admin reads it.
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['name', 'email', 'message', 'status', 'uid', 'lang', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3 && request.resource.data.email.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 2000
        && (!('uid' in request.resource.data)
            || (signedIn() && request.resource.data.uid == request.auth.uid))
        && (!('lang' in request.resource.data)
            || (request.resource.data.lang is string && request.resource.data.lang.size() <= 5))
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'read'];
    }

    // ---------------- landing content (admin-managed) ----------------
    // Screenshot URLs for the public landing page.
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- activity logs (admin) ----------------
    // Only a signed-in user may log, only about themselves, and only in the
    // shape src/data/services/activityLog.ts writes — this used to be
    // `create: if true`, an open, anonymous write path (spam + billed writes).
    match /activityLogs/{logId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type', 'uid', 'email', 'meta', 'createdAt', 'platform'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type is string && request.resource.data.type.size() <= 40
        && (!('meta' in request.resource.data)
            || (request.resource.data.meta is map && request.resource.data.meta.size() <= 5))
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // ======== admin panel (2026-10-11): roles, bans, audit, broadcasts ========

    // Staff roles. No document = ordinary user. Only an admin assigns roles,
    // and never their own (an admin cannot demote — or promote — themselves).
    // The owner account is admin by email and needs no document.
    match /staffRoles/{uid} {
      allow get: if isOwner(uid) || isStaff();
      allow list: if isStaff();
      allow create, update: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['role', 'updatedBy', 'updatedAt'])
        && request.resource.data.role in ['moderator', 'admin']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Blocked users. While a document exists, signedIn() rejects every write
    // by that user. Staff block/unblock; a moderator cannot touch staff.
    match /userBans/{uid} {
      allow get: if isOwner(uid) || isStaff();
      allow list: if isStaff();
      allow create: if isStaff()
        && uid != request.auth.uid
        && (isAdmin() || !exists(/databases/$(database)/documents/staffRoles/$(uid)))
        && request.resource.data.keys().hasOnly(['reason', 'bannedBy', 'createdAt', 'reportId'])
        && request.resource.data.bannedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500;
      allow update: if false;
      allow delete: if isStaff()
        && (isAdmin() || !exists(/databases/$(database)/documents/staffRoles/$(uid)));
    }

    // Admin action journal (Activity page). Append-only, staff only.
    match /adminLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(
             ['action', 'actorId', 'actorEmail', 'targetType', 'targetId', 'note', 'createdAt'])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action is string && request.resource.data.action.size() <= 40
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string && request.resource.data.note.size() <= 1000))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Announcements from the admin to every user (Notifications screen).
    // No per-user fan-out: each client reads this collection; push goes
    // through the optional Cloud Function (functions/) to the 'all' topic.
    match /broadcasts/{broadcastId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['title', 'body', 'link', 'createdAt', 'createdBy', 'createdByEmail'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 2000
        && (!('link' in request.resource.data)
            || (request.resource.data.link is string
                && request.resource.data.link.size() <= 500
                && request.resource.data.link.matches('https?://[^ ]+')))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Per-user "seen announcements up to" watermark.
    match /broadcastReads/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow delete: if false;
    }

    // Daily active users: one doc per user per UTC day, written by the client
    // on its first open of the day. Staff count them (count() aggregation).
    match /activeDays/{day}/users/{uid} {
      allow read: if isStaff();
      allow create, update: if isOwner(uid)
        && day == todayUtc()
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
      allow delete: if false;
    }

    // Sign-in email per user for admin search — kept out of the public
    // users/{uid} profile. Written by the owner, only with their own email.
    match /privateProfiles/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'emailLower', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailLower == request.auth.token.email.lower()
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
}
}
