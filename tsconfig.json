{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "types": [
      "react-native",
      "jest"
    ],
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "types",
    "App.tsx",
    "index.js"
  ]
}
